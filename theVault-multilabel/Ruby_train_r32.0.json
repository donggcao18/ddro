{"hexsha": "c93c23a473f1a45219b708f58182b66131b98306", "repo": "CDL-Dryad/dryad-app", "path": "stash/stash-sword/lib/stash/sword/sequence_io.rb", "identifier": "read_segment", "parameters": [{"param": "length", "type": null}, {"param": "buffer", "type": null}], "language": "Ruby", "text_id": "1001080809140101001", "url_based_id": "CDL-Dryad/dryad-app/stash/stash-sword/lib/stash/sword/sequence_io.rb/read_segment(length,buffer)", "numeric_id": "41323", "text": "Code: def read_segment(length, buffer)\n        return unless input && length > 0\n        remaining = length\n        if (result = input.read(length))\n          buffer << result\n          remaining = length - result.length\n        end\n        return unless remaining > 0\n        next_input!\n        read_segment(remaining, buffer)\n      end"}